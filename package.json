{
  "name": "dsh-desktop-app",
  "version": "0.2.5",
  "description": "Turn the DeepSeek Harness Web UI into a standalone desktop app window (Chromium --app mode) with a system-tray host: minimise to tray, reopen a closed window, and keep the local server running. / 把 DSH Web 界面变成独立桌面应用窗口，并常驻系统托盘：可最小化到托盘、关闭窗口后从托盘叫回、服务继续在后台运行。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "lib/tray-host.ps1",
    "lib/tray-host.cs",
    "lib/tray-host.cmd",
    "lib/tray.ico"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "desktop",
    "app-mode",
    "shortcut",
    "pwa",
    "system-tray",
    "notification-area"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MARIOMLY/dsh-desktop-app.git"
  },
  "homepage": "https://github.com/MARIOMLY/dsh-desktop-app",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "pack": "npm pack"
  }
}
