{
  "name": "dsh-desktop-app",
  "version": "0.1.0",
  "description": "Turn the DeepSeek Harness Web UI into a standalone desktop app window (Chromium --app mode) — install, remove and open the shortcut from inside a DSH session. / 把 DSH Web 界面变成独立桌面应用窗口：在会话内一键安装、卸载与打开快捷方式。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "desktop",
    "app-mode",
    "shortcut",
    "pwa"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MARIOMLY/dsh-desktop-app.git"
  },
  "homepage": "https://github.com/MARIOMLY/dsh-desktop-app",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
